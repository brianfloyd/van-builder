{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true
  },
  "include": ["bridge-paths.ts", "bridge-protocol.ts", "vite-project-bridge.ts", "vite.config.ts", "mcp-server/**/*.ts", "scripts/**/*.ts"]
}
